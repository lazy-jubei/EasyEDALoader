<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>EasyEDA-Loader</AssemblyName>
    <RootNamespace>EasyEDA_Loader</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AltiumInstallDir Condition="'$(AltiumInstallDir)' == ''">$(ALTIUM_INSTALL_DIR)</AltiumInstallDir>
    <AltiumInstallDir Condition="'$(AltiumInstallDir)' == ''">C:\Program Files\Altium\AD26</AltiumInstallDir>
    <DevExpressVersion Condition="'$(DevExpressVersion)' == ''">25.2</DevExpressVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Altium.Controls"><HintPath>$(AltiumInstallDir)/System/Altium.Controls.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Altium.SDK"><HintPath>$(AltiumInstallDir)/System/Altium.SDK.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Altium.SDK.Interfaces"><HintPath>$(AltiumInstallDir)/System/Altium.SDK.Interfaces.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Data.v$(DevExpressVersion)"><HintPath>$(AltiumInstallDir)/System/DotNet/DevExpress.Wpf/DevExpress.Data.v$(DevExpressVersion).dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Data.Desktop.v$(DevExpressVersion)"><HintPath>$(AltiumInstallDir)/System/DotNet/DevExpress.Wpf/DevExpress.Data.Desktop.v$(DevExpressVersion).dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Mvvm.v$(DevExpressVersion)"><HintPath>$(AltiumInstallDir)/System/DotNet/DevExpress.Wpf/DevExpress.Mvvm.v$(DevExpressVersion).dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Printing.v$(DevExpressVersion).Core"><HintPath>$(AltiumInstallDir)/System/DotNet/DevExpress.Wpf/DevExpress.Printing.v$(DevExpressVersion).Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Utils.v$(DevExpressVersion)"><HintPath>$(AltiumInstallDir)/System/DotNet/DevExpress.Wpf/DevExpress.Utils.v$(DevExpressVersion).dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Xpf.Core.v$(DevExpressVersion)"><HintPath>$(AltiumInstallDir)/System/DotNet/DevExpress.Wpf/DevExpress.Xpf.Core.v$(DevExpressVersion).dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Xpf.Grid.v$(DevExpressVersion).Core"><HintPath>$(AltiumInstallDir)/System/DotNet/DevExpress.Wpf/DevExpress.Xpf.Grid.v$(DevExpressVersion).Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DevExpress.Xpf.Grid.v$(DevExpressVersion)"><HintPath>$(AltiumInstallDir)/System/DotNet/DevExpress.Wpf/DevExpress.Xpf.Grid.v$(DevExpressVersion).dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateAltiumSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AltiumInstallDir)/System/Altium.SDK.dll')" Text="Altium SDK not found. Set AltiumInstallDir (or ALTIUM_INSTALL_DIR) to your Altium Designer 26 installation." />
    <Error Condition="!Exists('$(AltiumInstallDir)/System/DotNet/DevExpress.Wpf/DevExpress.Xpf.Grid.v$(DevExpressVersion).dll')" Text="DevExpress $(DevExpressVersion) not found in this Altium installation. Set DevExpressVersion to its installed version." />
  </Target>

  <ItemGroup>
    <Content Include="EasyEDA-Loader.Ins"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <Content Include="EasyEDA-Loader.rcs"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Properties\licenses.licx" />
    <None Remove="packages.config" />
  </ItemGroup>

</Project>
