<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>EasyEDALoader-Setup</AssemblyName>
    <AssemblyTitle>EasyEDA Loader Setup</AssemblyTitle>
    <Version>1.3.0</Version>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="'$(PayloadZip)' != ''" />
    <Reference Include="System.IO.Compression;System.Web.Extensions" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="PreparePayload" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(PayloadZip)')" Text="Build a deployment payload with installer/Build-Installer.ps1 or provide -p:PayloadZip." />
    <GetFileHash Files="$(PayloadZip)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="PayloadHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)PayloadManifest.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="internal static class PayloadManifest { internal const string Sha256 = &quot;%(PayloadHash.FileHash)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PayloadManifest.cs" />
    </ItemGroup>
  </Target>
</Project>
